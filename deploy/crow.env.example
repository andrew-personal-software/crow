# Copy to /etc/crow/crow.env (root:crow, mode 640). Generate secrets with: openssl rand -hex 32
# Must equal the CROW_PROXY_SECRET in Caddy's environment (see deploy/authentik/Caddyfile.snippet).
CROW_PROXY_SECRET=change-me
SPARROW_URL=http://127.0.0.1:<sparrow port>
# Must equal SPARROW_SERVICE_TOKEN in /etc/sparrow/sparrow.env.
SPARROW_SERVICE_TOKEN=change-me
CROW_PUBLIC_URL=https://crow.andrewminghanjiang.com
